FROM python:3.11-slim

# Small image to run a local ChromaDB HTTP server by installing the Python package
WORKDIR /chroma

# Install system deps required by some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Chroma and a production ASGI server
RUN pip install --no-cache-dir chromadb uvicorn[standard]

# Expose default Chroma HTTP port
EXPOSE 8000

# Start the Chroma FastAPI app using uvicorn
CMD ["uvicorn", "chromadb.server.fastapi:app", "--host", "0.0.0.0", "--port", "8000"]
