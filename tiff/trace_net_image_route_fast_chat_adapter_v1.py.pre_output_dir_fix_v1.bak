from __future__ import annotations

import argparse
import hashlib
import json
import re
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple

STATUS = "TRACE_NET_IMAGE_ROUTE_FAST_CHAT_ADAPTER_BUILT"
SCHEMA_VERSION = "trace_net_image_route_fast_chat_adapter_v1"
ROUTE_TYPE = "image_or_diagram"

UNSUPPORTED_TERMS = (
    "interchangeable",
    "interchangeability",
    "approved replacement",
    "replacement approval",
    "safe to install",
    "installation safety",
    "effectivity",
    "guaranteed fit",
    "approved substitute",
    "direct substitute",
)


def _as_path(path: Any) -> Path:
    return path if isinstance(path, Path) else Path(str(path))


def _load_json(path: Any) -> Dict[str, Any]:
    p = _as_path(path)
    with p.open("r", encoding="utf-8") as f:
        return json.load(f)


def _safe_int(value: Any) -> Optional[int]:
    try:
        if value is None or value == "":
            return None
        return int(str(value).strip())
    except (TypeError, ValueError):
        return None


def _norm_text(value: Any) -> str:
    return str(value or "").strip()


def _records(pack: Dict[str, Any]) -> List[Dict[str, Any]]:
    records = pack.get("records")
    return records if isinstance(records, list) else []


def _extract_figure(question: str) -> str:
    q = question or ""
    patterns = [
        r"\bfig(?:ure)?\.?\s*#?\s*([0-9]{1,4}[A-Za-z]?)\b",
        r"\bdiagram\s*#?\s*([0-9]{1,4}[A-Za-z]?)\b",
        r"\bimage\s*#?\s*([0-9]{1,4}[A-Za-z]?)\b",
    ]
    for pat in patterns:
        m = re.search(pat, q, re.IGNORECASE)
        if m:
            return m.group(1).lstrip("0") or "0"
    # Last resort: only use a number if the question clearly sounds visual.
    if re.search(r"\b(figure|fig|diagram|callout|image|visual)\b", q, re.IGNORECASE):
        m = re.search(r"\b([0-9]{1,4})\b", q)
        if m:
            return m.group(1).lstrip("0") or "0"
    return ""


def _extract_callout(question: str) -> str:
    q = question or ""
    patterns = [
        r"\b(?:callout|item)\s*#?\s*([0-9]{1,4}[A-Za-z]?)\b",
        r"\bfig(?:ure)?\.?\s*[0-9]{1,4}[A-Za-z]?\s+(?:callout|item)\s*#?\s*([0-9]{1,4}[A-Za-z]?)\b",
    ]
    for pat in patterns:
        m = re.search(pat, q, re.IGNORECASE)
        if m:
            return m.group(1).lstrip("0") or "0"
    return ""


def _figure_equal(a: Any, b: Any) -> bool:
    aa = _norm_text(a).upper().lstrip("0") or "0"
    bb = _norm_text(b).upper().lstrip("0") or "0"
    return aa == bb and aa != ""


def _callout_equal(a: Any, b: Any) -> bool:
    aa = _norm_text(a).upper().lstrip("0") or "0"
    bb = _norm_text(b).upper().lstrip("0") or "0"
    return aa == bb and aa != ""


def _is_linked_record(record: Dict[str, Any]) -> bool:
    return bool(record.get("linked")) and bool(record.get("citation_ready")) and bool(record.get("source_trace_ready"))


def _is_low_record(record: Dict[str, Any]) -> bool:
    return _norm_text(record.get("link_confidence")).upper() == "LOW" or not record.get("linked")


def select_evidence(records: Iterable[Dict[str, Any]], question: str, max_records: int = 5) -> Tuple[List[Dict[str, Any]], str, str]:
    figure = _extract_figure(question)
    callout = _extract_callout(question)
    all_records = list(records)

    if figure:
        exact: List[Dict[str, Any]] = []
        for r in all_records:
            if not _figure_equal(r.get("figure"), figure):
                continue
            if callout and not _callout_equal(r.get("callout"), callout):
                continue
            if _is_linked_record(r):
                exact.append(r)
        if exact:
            return exact[:max_records], figure, callout

        # Keep only low/unlinked candidates for limitation output if no trusted match exists.
        low = [r for r in all_records if _figure_equal(r.get("figure"), figure) and _is_low_record(r)]
        if low:
            return low[:max_records], figure, callout

    linked = [r for r in all_records if _is_linked_record(r)]
    if linked:
        return linked[:max_records], figure, callout
    return all_records[:max_records], figure, callout


def _citation(record: Dict[str, Any]) -> Dict[str, Any]:
    return {
        "citation_label": record.get("citation_label") or "",
        "page_id": record.get("page_id") or "",
        "page_number": record.get("page_number"),
        "figure": record.get("figure") or "",
        "callout": record.get("callout") or "",
        "linked_part_number": record.get("linked_part_number") or "",
        "linked_description": record.get("linked_description") or "",
        "link_confidence": record.get("link_confidence") or "",
        "proof_strength": record.get("proof_strength") or "",
        "source_trace_ready": bool(record.get("source_trace_ready")),
        "citation_ready": bool(record.get("citation_ready")),
        "proof_source": record.get("proof_source") or "",
        "visual_source": record.get("visual_source") or "llava_ocr_visual_route",
    }


def compose_answer(question: str, selected: List[Dict[str, Any]], requested_figure: str = "", requested_callout: str = "") -> Tuple[str, List[Dict[str, Any]], Dict[str, int]]:
    citations = [_citation(r) for r in selected if r.get("citation_ready")]
    linked = [c for c in citations if c.get("linked_part_number") and c.get("source_trace_ready")]

    if linked:
        lines: List[str] = []
        for c in linked:
            label = c.get("citation_label") or "V?"
            figure = c.get("figure") or requested_figure or "the requested figure"
            part = c.get("linked_part_number")
            page = c.get("page_number")
            callout = c.get("callout")
            desc = c.get("linked_description")
            if callout:
                subject = f"Figure {figure} callout/item {callout}"
            else:
                subject = f"Figure {figure}"
            if desc:
                lines.append(f"{subject} is linked to part number {part}, {desc}, on page {page} [{label}].")
            else:
                lines.append(f"{subject} is linked to part number {part} on page {page} [{label}].")
        if any((_norm_text(c.get("link_confidence")).upper() == "MEDIUM") for c in linked):
            lines.append(
                "This is a MEDIUM-confidence visual answer because TRACE-Net has trusted figure/page evidence, "
                "but not a full exact visual callout/item match for every cited record."
            )
        if not all(c.get("linked_description") for c in linked):
            lines.append("A clean nomenclature/description is not available in the current visual link record for at least one cited part.")
        lines.append(
            "The evidence does not prove interchangeability, effectivity, fit, replacement approval, or installation safety."
        )
        answer = " ".join(lines)
    else:
        fig = requested_figure or "the requested figure"
        answer = (
            f"TRACE-Net found visual/OCR candidates for {fig}, but none are linked to trusted OCR/table/figure-item proof yet. "
            "I cannot identify a part number from LLaVA-only or OCR-only visual observations. "
            "The record should remain review-only until a source-traced table/figure-item link is available."
        )

    lower = answer.lower()
    unsupported_claim_count = 0
    # These words are allowed only in the explicit limitation sentence. Count unsupported only if phrased affirmatively.
    affirmative_unsafe_patterns = [
        r"\bis\s+interchangeable\b",
        r"\bare\s+interchangeable\b",
        r"\bapproved\s+replacement\b",
        r"\bsafe\s+to\s+install\b",
        r"\bguaranteed\s+fit\b",
    ]
    for pat in affirmative_unsafe_patterns:
        if re.search(pat, lower):
            unsupported_claim_count += 1

    llava_only_part_identity_claim_count = 0
    if re.search(r"part\s+number\s+[0-9]{2,}-[0-9]{2,}-[0-9A-Za-z]{2,}", answer, re.IGNORECASE) and not linked:
        llava_only_part_identity_claim_count = 1

    return answer, citations, {
        "unsupported_claim_count": unsupported_claim_count,
        "llava_only_part_identity_claim_count": llava_only_part_identity_claim_count,
    }


def build_adapter(
    *,
    image_visual_evidence_pack: Any,
    question: str,
    output_dir: Any,
    require_webui_answer_ready: bool = False,
    min_citations: int = 0,
    min_source_trace_ready_citations: int = 0,
    max_unsupported_claims: int = 0,
    max_llava_only_part_identity_claims: int = 0,
    max_unsafe: int = 0,
    max_answer_permission: int = 0,
    max_source_truth_mutation_allowed: int = 0,
    max_write_attempts: int = 0,
) -> Dict[str, Any]:
    image_visual_evidence_pack_path = _as_path(image_visual_evidence_pack)
    output_dir_path = _as_path(output_dir)
    pack = _load_json(image_visual_evidence_pack_path)
    selected, requested_figure, requested_callout = select_evidence(_records(pack), question)
    answer, citations, claim_counts = compose_answer(question, selected, requested_figure, requested_callout)

    citation_count = len(citations)
    source_trace_ready_citation_count = sum(1 for c in citations if c.get("source_trace_ready"))
    linked_selected_evidence_count = sum(1 for r in selected if r.get("linked"))
    linked_citation_count = sum(1 for c in citations if c.get("linked_part_number"))

    unsafe_record_count = sum(1 for r in selected if r.get("unsafe") or r.get("unsafe_record"))
    answer_permission_count = sum(1 for r in selected if r.get("answer_permission"))
    source_truth_mutation_allowed_count = sum(1 for r in selected if r.get("source_truth_mutation_allowed"))
    write_attempt_count = sum(
        1
        for r in selected
        if r.get("postgres_write_attempt")
        or r.get("qdrant_write_attempt")
        or r.get("opensearch_write_attempt")
        or r.get("opensearch_upload_attempt")
        or r.get("write_attempt")
    )

    webui_answer_ready = (
        citation_count >= min_citations
        and source_trace_ready_citation_count >= min_source_trace_ready_citations
        and claim_counts["unsupported_claim_count"] <= max_unsupported_claims
        and claim_counts["llava_only_part_identity_claim_count"] <= max_llava_only_part_identity_claims
        and unsafe_record_count <= max_unsafe
        and answer_permission_count <= max_answer_permission
        and source_truth_mutation_allowed_count <= max_source_truth_mutation_allowed
        and write_attempt_count <= max_write_attempts
        and linked_selected_evidence_count > 0
    )

    checks = {
        "citation_count_min_met": citation_count >= min_citations,
        "source_trace_ready_citation_min_met": source_trace_ready_citation_count >= min_source_trace_ready_citations,
        "unsupported_claim_max_met": claim_counts["unsupported_claim_count"] <= max_unsupported_claims,
        "llava_only_part_identity_claim_max_met": claim_counts["llava_only_part_identity_claim_count"] <= max_llava_only_part_identity_claims,
        "unsafe_max_met": unsafe_record_count <= max_unsafe,
        "answer_permission_max_met": answer_permission_count <= max_answer_permission,
        "source_truth_mutation_allowed_max_met": source_truth_mutation_allowed_count <= max_source_truth_mutation_allowed,
        "write_attempt_max_met": write_attempt_count <= max_write_attempts,
        "linked_visual_evidence_present": linked_selected_evidence_count > 0,
        "webui_answer_ready_required_met": (not require_webui_answer_ready) or webui_answer_ready,
    }
    quality_status = "PASS" if all(checks.values()) else "FAIL"

    summary = {
        "route_type": ROUTE_TYPE,
        "stage_count": 3,
        "selected_evidence_record_count": len(selected),
        "linked_selected_evidence_count": linked_selected_evidence_count,
        "citation_count": citation_count,
        "linked_citation_count": linked_citation_count,
        "source_trace_ready_citation_count": source_trace_ready_citation_count,
        "unsupported_claim_count": claim_counts["unsupported_claim_count"],
        "llava_only_part_identity_claim_count": claim_counts["llava_only_part_identity_claim_count"],
        "unsafe_record_count": unsafe_record_count,
        "answer_permission_count": answer_permission_count,
        "source_truth_mutation_allowed_count": source_truth_mutation_allowed_count,
        "write_attempt_count": write_attempt_count,
        "webui_answer_ready": webui_answer_ready,
        "requested_figure": requested_figure,
        "requested_callout": requested_callout,
    }

    result = {
        "schema_version": SCHEMA_VERSION,
        "status": STATUS,
        "quality_status": quality_status,
        "route_type": ROUTE_TYPE,
        "api_response_status": "citation_backed_visual_fast_chat_answer" if webui_answer_ready else "visual_fast_chat_review_only",
        "question": question,
        "answer": answer,
        "webui_answer_ready": webui_answer_ready,
        "citations": citations,
        "selected_records": selected,
        "stages": [
            {"stage": "image_visual_evidence_pack", "status": pack.get("status", "loaded"), "quality_status": pack.get("quality_status")},
            {"stage": "image_diagram_fast_answer_adapter", "status": STATUS, "quality_status": quality_status},
            {"stage": "image_route_quality_contract", "webui_answer_ready": webui_answer_ready},
        ],
        "summary": summary,
        "checks": checks,
        "safety_contract": {
            "postgres_write_attempt": False,
            "qdrant_write_attempt": False,
            "opensearch_write_attempt": False,
            "opensearch_upload_attempt": False,
            "source_truth_mutation_allowed": False,
            "answer_permission": False,
            "llava_is_proof": False,
            "visual_answer_requires_linked_proof": True,
        },
    }

    output_dir_path.mkdir(parents=True, exist_ok=True)
    stem = "trace_net_image_route_fast_chat_adapter_v1"
    out_path = output_dir_path / f"{stem}.json"
    slug = re.sub(r"[^a-z0-9]+", "_", question.lower()).strip("_")[:80] or "question"
    h = hashlib.sha1(question.encode("utf-8")).hexdigest()[:8]
    question_path = output_dir_path / f"{stem}_{slug}_{h}.json"
    out_path.write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
    question_path.write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
    result["paths"] = {"adapter": str(out_path), "question_adapter": str(question_path)}
    out_path.write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
    question_path.write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
    return result


def _parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Build TRACE-Net image route fast chat adapter v1")
    p.add_argument("--image-visual-evidence-pack", required=True)
    p.add_argument("--question", required=True)
    p.add_argument("--output-dir", default="local_data/organization/trace_net/image_route_fast_chat_adapter_v1")
    p.add_argument("--require-webui-answer-ready", action="store_true")
    p.add_argument("--min-citations", type=int, default=0)
    p.add_argument("--min-source-trace-ready-citations", type=int, default=0)
    p.add_argument("--max-unsupported-claims", type=int, default=0)
    p.add_argument("--max-llava-only-part-identity-claims", type=int, default=0)
    p.add_argument("--max-unsafe", type=int, default=0)
    p.add_argument("--max-answer-permission", type=int, default=0)
    p.add_argument("--max-source-truth-mutation-allowed", type=int, default=0)
    p.add_argument("--max-write-attempts", type=int, default=0)
    return p.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = _parse_args(argv)
    result = build_adapter(
        image_visual_evidence_pack=Path(args.image_visual_evidence_pack),
        question=args.question,
        output_dir=Path(args.output_dir),
        require_webui_answer_ready=args.require_webui_answer_ready,
        min_citations=args.min_citations,
        min_source_trace_ready_citations=args.min_source_trace_ready_citations,
        max_unsupported_claims=args.max_unsupported_claims,
        max_llava_only_part_identity_claims=args.max_llava_only_part_identity_claims,
        max_unsafe=args.max_unsafe,
        max_answer_permission=args.max_answer_permission,
        max_source_truth_mutation_allowed=args.max_source_truth_mutation_allowed,
        max_write_attempts=args.max_write_attempts,
    )
    s = result["summary"]
    print(f"status={result['status']}")
    print(f"quality_status={result['quality_status']}")
    print(f"route_type={result['route_type']}")
    print(f"api_response_status={result['api_response_status']}")
    print(f"citation_count={s['citation_count']}")
    print(f"source_trace_ready_citation_count={s['source_trace_ready_citation_count']}")
    print(f"linked_selected_evidence_count={s['linked_selected_evidence_count']}")
    print(f"webui_answer_ready={result['webui_answer_ready']}")
    print(f"unsupported_claim_count={s['unsupported_claim_count']}")
    print(f"llava_only_part_identity_claim_count={s['llava_only_part_identity_claim_count']}")
    print(f"unsafe_record_count={s['unsafe_record_count']}")
    print(f"answer_permission_count={s['answer_permission_count']}")
    print(f"source_truth_mutation_allowed_count={s['source_truth_mutation_allowed_count']}")
    print(f"write_attempt_count={s['write_attempt_count']}")
    print(f"answer={result['answer']}")
    print(f"adapter={result['paths']['adapter']}")
    return 0 if result["quality_status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
