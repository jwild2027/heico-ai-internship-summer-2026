from __future__ import annotations

import argparse
import json
import re
import time
import urllib.request
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional


MODULE = "trace_net_h38_diversity_task_runner_v1"
VERSION = "v1"


def _read_json(path: str | Path) -> Any:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True), encoding="utf-8")


def _write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def _norm(v: Any) -> str:
    return re.sub(r"\s+", " ", str(v or "")).strip()


def _labels_from_cards(cards: List[Mapping[str, Any]]) -> List[str]:
    labels = []
    seen = set()
    for c in cards:
        label = _norm(c.get("evidence_label"))
        if label and label not in seen:
            seen.add(label)
            labels.append(label)
    return labels


def _route_count(cards: List[Mapping[str, Any]]) -> int:
    return len({_norm(c.get("route")).lower() for c in cards if _norm(c.get("route"))})


def _page_count(cards: List[Mapping[str, Any]]) -> int:
    return len({_norm(c.get("page")).lower() for c in cards if _norm(c.get("page"))})


def _part_count(cards: List[Mapping[str, Any]]) -> int:
    return len({_norm(c.get("part_number")).lower() for c in cards if _norm(c.get("part_number"))})


def _figure_count(cards: List[Mapping[str, Any]]) -> int:
    return len({_norm(c.get("figure")).lower() for c in cards if _norm(c.get("figure"))})


def _contains_safe_negation(text: str, term: str) -> bool:
    t = text.lower()
    term_l = term.lower()
    patterns = [
        rf"\bdoes\s+not\s+(?:prove|verify|establish|show|confirm)\b[^.:\n;]{{0,120}}\b{re.escape(term_l)}\b",
        rf"\bnot\s+(?:prove|verified|established|shown|confirmed|source-trace-ready)\b[^.:\n;]{{0,120}}\b{re.escape(term_l)}\b",
        rf"\bcannot\s+(?:prove|verify|establish|show|confirm)\b[^.:\n;]{{0,120}}\b{re.escape(term_l)}\b",
        rf"\bno\b[^.:\n;]{{0,80}}\b{re.escape(term_l)}\b",
    ]
    return any(re.search(p, t) for p in patterns)


def unsafe_forbidden_claims(answer: str) -> List[str]:
    claims = []
    terms = [
        "interchangeability",
        "interchangeable",
        "approved replacement",
        "replacement approval",
        "installation safety",
        "installation safe",
        "effectivity",
        "fit approval",
        "safe to install",
    ]
    for term in terms:
        if term in answer.lower() and not _contains_safe_negation(answer, term):
            claims.append(f"possible_forbidden_claim:{term}")
    return sorted(set(claims))


def build_prompt(record: Mapping[str, Any], answer_hard_max_chars: int = 1500) -> str:
    task_type = _norm(record.get("task_type"))
    qid = _norm(record.get("question_id"))
    question = _norm(record.get("query_text") or record.get("question"))
    cards = record.get("selected_cards", []) or []

    lines = [
        "TRACE-NET H38 DIVERSITY TASK RUNNER",
        "",
        "You are a cautious, source-trace-first engineering assistant.",
        "Use only the selected evidence cards below as proof_context.",
        "Planner/Engram/diversity guidance is not proof by itself.",
        "Only cited evidence cards can support factual claims.",
        "",
        f"target_question_id: {qid}",
        f"task_type: {task_type}",
        "",
        "GLOBAL RULES:",
        f"- Keep the full answer under {answer_hard_max_chars} characters.",
        "- Finish all sections; do not stop mid-sentence.",
        "- Use individual citations like [V7] [O2], not grouped citations like [V7, O2].",
        "- Do not claim interchangeability, fit, effectivity, replacement approval, or installation safety unless explicit evidence says so.",
        "- It is allowed and encouraged to say what TRACE-Net cannot prove.",
        "- Do not use summaries, Engram memory, metadata, or route hints as proof.",
        "",
        "SELECTED SOURCE-TRACE EVIDENCE CARDS:",
    ]

    for c in cards[:10]:
        lines.append(
            f"[{c.get('evidence_label')}] route={c.get('route')} page={c.get('page')} "
            f"figure={c.get('figure')} part={c.get('part_number')} nomenclature={c.get('nomenclature')} | "
            f"{_norm(c.get('preview'))[:360]}"
        )

    lines.extend(["", "TASK-SPECIFIC CONTRACT:"])

    if task_type == "quiz_generation":
        lines.extend([
            "- Create exactly 5 technician quiz questions.",
            "- Include a separate Answer Key.",
            "- Each answer key item must cite at least one evidence card.",
            "- Use at least 4 unique citation labels across the quiz.",
            "- Use at least 2 evidence routes.",
            "- Include one question about what TRACE-Net cannot prove.",
            "- Do not ask internal metadata questions such as source_extractor_quality_pass, quality_status, module, schema_version, or record_count.",
            "- Prefer useful field questions: part number, figure, nomenclature, route support, and proof limits.",
        ])
    elif task_type == "multi_page_summary":
        lines.extend([
            "- Summarize at least 3 different pages/figures if available.",
            "- Use the phrase source-trace-ready.",
            "- For each item, state what is proven and what remains unproven.",
            "- Use at least 4 unique citation labels and at least 2 routes if available.",
        ])
    elif task_type == "nomenclature_lookup":
        lines.extend([
            "- State the nomenclature.",
            "- Explain which route proves the part name.",
            "- Explain which route proves the figure-to-part link.",
            "- State limits.",
        ])
    elif task_type == "representative_page_explanation":
        lines.extend([
            "- Pick one representative source-trace-ready page/figure/record.",
            "- Explain what TRACE-Net can safely say.",
            "- State limits using negated boundary language.",
        ])
    else:
        lines.extend([
            "- Answer directly using the selected evidence.",
            "- Include Answer, Evidence, Engineering confidence, and Limits.",
        ])

    lines.extend([
        "",
        "USER QUESTION:",
        question,
        "",
        "Return only the final answer. Use sections when appropriate.",
    ])

    return "\n".join(lines)


def call_ollama(
    prompt: str,
    model: str,
    url: str,
    timeout_seconds: int = 420,
    retry_prompt: Optional[str] = None,
) -> tuple[str, str]:
    def _call(p: str) -> str:
        payload = {"model": model, "prompt": p, "stream": False, "options": {"temperature": 0.1}}
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout_seconds) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        answer = _norm(data.get("response") or data.get("answer") or "")
        if not answer:
            raise RuntimeError("Ollama response did not contain answer text")
        return answer

    try:
        return _call(prompt), ""
    except Exception as e1:
        if not retry_prompt:
            return "", str(e1)
        try:
            return _call(retry_prompt), ""
        except Exception as e2:
            return "", f"{e1}; retry_failed: {e2}"


def artifact_answer(record: Mapping[str, Any]) -> str:
    task_type = _norm(record.get("task_type"))
    cards = record.get("selected_cards", []) or []
    labels = _labels_from_cards(cards)
    first = cards[0] if cards else {}
    cite = " ".join(f"[{x}]" for x in labels[:5])

    if task_type == "quiz_generation":
        usable = cards[:5]
        q_lines = ["Technician Training Quiz"]
        for i, c in enumerate(usable, 1):
            part = c.get("part_number") or "the selected part"
            fig = c.get("figure") or "the selected figure"
            label = c.get("evidence_label")
            if i == 4:
                q_lines.append(f"{i}. Does TRACE-Net prove interchangeability, fit, or installation safety from the selected evidence?")
            else:
                q_lines.append(f"{i}. What can TRACE-Net identify about part {part} or figure {fig}?")
        q_lines.append("")
        q_lines.append("Answer Key")
        for i, c in enumerate(usable, 1):
            label = c.get("evidence_label")
            if i == 4:
                q_lines.append(f"{i}. No. The evidence supports identification only, not interchangeability, fit, or installation safety [{label}].")
            else:
                value = c.get("nomenclature") or c.get("part_number") or c.get("figure") or c.get("route")
                q_lines.append(f"{i}. {value} [{label}].")
        return "\n".join(q_lines)

    return (
        "Answer:\n"
        f"TRACE-Net can safely use the selected source-trace-ready evidence cards {cite} for this task. "
        f"The strongest selected card is [{first.get('evidence_label')}] route={first.get('route')} "
        f"page={first.get('page')} figure={first.get('figure')} part={first.get('part_number')} "
        f"nomenclature={first.get('nomenclature')}.\n\n"
        f"Evidence:\n{cite}\n\n"
        "Engineering confidence:\nMEDIUM/HIGH for claims directly supported by the cited cards.\n\n"
        "Limits:\nThis does not prove interchangeability, effectivity, fit, replacement approval, or installation safety."
    )


def validate_answer(record: Mapping[str, Any], answer: str, fallback_used: bool, answer_hard_max_chars: int) -> Dict[str, Any]:
    task_type = _norm(record.get("task_type"))
    cards = record.get("selected_cards", []) or []
    labels = _labels_from_cards(cards)
    cited = sorted(set(re.findall(r"\[([A-Z][0-9]+)\]", answer)))
    valid_cited = [x for x in cited if x in labels]
    findings = []

    if fallback_used:
        findings.append("fallback_used")
    if len(answer) > answer_hard_max_chars:
        findings.append(f"answer_too_long:{len(answer)}>{answer_hard_max_chars}")
    if not valid_cited:
        findings.append("missing_valid_citations")
    unsafe = unsafe_forbidden_claims(answer)
    findings.extend(unsafe)

    if re.search(r"\[[A-Z][0-9]+,\s*[A-Z][0-9]+", answer):
        findings.append("grouped_citation_syntax")

    if task_type == "quiz_generation":
        quiz_q_count = len(re.findall(r"(?m)^\s*(?:Q?\d+[\).\:]|[-*]\s*Q?\d+)", answer))
        # Count numbered answer-key lines too; require evidence of a quiz and answer key.
        if "answer key" not in answer.lower():
            findings.append("missing_answer_key")
        if quiz_q_count < 5:
            findings.append(f"too_few_quiz_questions:{quiz_q_count}<5")
        if len(valid_cited) < 4:
            findings.append(f"too_few_quiz_citations:{len(valid_cited)}<4")
        if _route_count(cards) < 2:
            findings.append("too_few_selected_routes_for_quiz")
        if re.search(r"source_extractor_quality_pass|quality_status|schema_version|record_count|module", answer, re.I):
            findings.append("metadata_quiz_item")
        if not any(term in answer.lower() for term in ["cannot prove", "does not prove", "not prove", "limits"]):
            findings.append("missing_limits_quiz_item")

    if task_type == "multi_page_summary":
        if "source-trace" not in answer.lower():
            findings.append("missing_source_trace_wording")
        if len(valid_cited) < 4:
            findings.append(f"too_few_summary_citations:{len(valid_cited)}<4")
        if _route_count(cards) < 2:
            findings.append("too_few_selected_routes_for_summary")
        if _page_count(cards) < 3:
            findings.append("too_few_selected_pages_for_summary")

    grade = "GOOD"
    contract_pass = True
    if findings:
        contract_pass = False
        unsafeish = [f for f in findings if f.startswith("possible_forbidden_claim")]
        if fallback_used or unsafeish or "missing_valid_citations" in findings:
            grade = "BAD"
        else:
            grade = "PARTIAL"

    return {
        "grade": grade,
        "contract_pass": contract_pass,
        "findings": findings,
        "answer_citation_count": len(cited),
        "valid_answer_citation_count": len(valid_cited),
        "unsupported_claim_count": len([f for f in findings if f.startswith("possible_forbidden_claim")]),
    }


def _compact_retry_prompt(prompt: str, hard_max: int) -> str:
    # Keep the rules, selected cards, and task. Drop some verbose wording by truncating middle if needed.
    return prompt[:5500] + f"\n\nIMPORTANT: Return a complete answer under {hard_max} characters. Do not return empty text."


def run_diversity_task_runner(
    diversity_planner: str | Path,
    output_dir: str | Path,
    llm_mode: str = "ollama",
    ollama_model: str = "gemma4:26b",
    ollama_url: str = "http://127.0.0.1:11434/api/generate",
    timeout_seconds: int = 420,
    max_questions: int = 5,
    answer_hard_max_chars: int = 1500,
    min_good_answers: int = 5,
    min_contract_pass: int = 5,
    max_fallback_used: int = 0,
    progress: bool = True,
) -> Dict[str, Any]:
    data = _read_json(diversity_planner)
    records_in = (data.get("plan_records") or [])[:max_questions]
    out = Path(output_dir)
    pdir = out / "p"
    adir = out / "a"
    tdir = out / "t"
    out.mkdir(parents=True, exist_ok=True)

    records = []
    start = time.time()

    for idx, rec in enumerate(records_in, 1):
        prompt = build_prompt(rec, answer_hard_max_chars=answer_hard_max_chars)
        qid = _norm(rec.get("question_id")) or f"q{idx:02d}"
        prompt_path = pdir / f"{idx:02d}_{qid}_p.txt"
        answer_path = adir / f"{idx:02d}_{qid}_a.txt"
        trace_path = tdir / f"{idx:02d}_{qid}_trace.json"
        _write_text(prompt_path, prompt)

        fallback_used = False
        llm_error = ""
        if llm_mode == "artifact":
            answer = artifact_answer(rec)
        elif llm_mode == "ollama":
            retry = _compact_retry_prompt(prompt, answer_hard_max_chars)
            answer, llm_error = call_ollama(prompt, ollama_model, ollama_url, timeout_seconds, retry_prompt=retry)
            if not answer:
                fallback_used = True
                answer = artifact_answer(rec)
        else:
            raise ValueError(f"unsupported llm_mode: {llm_mode}")

        _write_text(answer_path, answer)
        validation = validate_answer(rec, answer, fallback_used, answer_hard_max_chars)
        record = {
            "question_id": qid,
            "task_type": rec.get("task_type"),
            "query_text": rec.get("query_text"),
            "grade": validation["grade"],
            "contract_pass": validation["contract_pass"],
            "findings": validation["findings"],
            "fallback_used": fallback_used,
            "llm_error": llm_error,
            "answer_char_count": len(answer),
            "answer_citation_count": validation["answer_citation_count"],
            "valid_answer_citation_count": validation["valid_answer_citation_count"],
            "unsupported_claim_count": validation["unsupported_claim_count"],
            "selected_evidence_labels": rec.get("selected_evidence_labels"),
            "selected_routes": rec.get("selected_routes"),
            "selected_pages": rec.get("selected_pages"),
            "selected_part_numbers": rec.get("selected_part_numbers"),
            "selected_figures": rec.get("selected_figures"),
            "prompt_path": str(prompt_path),
            "answer_path": str(answer_path),
            "trace_path": str(trace_path),
            "answer_preview": answer[:2400],
            "answer_permission": False,
            "source_truth_mutation_allowed": False,
            "unsafe": validation["unsupported_claim_count"] > 0,
            "write_attempt_count": 0,
        }
        _write_json(trace_path, record)
        records.append(record)

        if progress:
            elapsed = time.time() - start
            print(
                f"[H38 progress] {idx}/{len(records_in)} ({idx / max(1, len(records_in)) * 100:.1f}%) "
                f"qid={qid} grade={record['grade']} contract={record['contract_pass']} "
                f"fallback={fallback_used} citations={record['valid_answer_citation_count']} "
                f"chars={record['answer_char_count']} elapsed={elapsed:.1f}s",
                flush=True,
            )

    summary = {
        "module": MODULE,
        "version": VERSION,
        "question_count": len(records),
        "good_answer_count": sum(1 for r in records if r["grade"] == "GOOD"),
        "partial_answer_count": sum(1 for r in records if r["grade"] == "PARTIAL"),
        "bad_answer_count": sum(1 for r in records if r["grade"] == "BAD"),
        "contract_pass_count": sum(1 for r in records if r["contract_pass"]),
        "fallback_used_count": sum(1 for r in records if r["fallback_used"]),
        "unsupported_claim_count": sum(int(r.get("unsupported_claim_count") or 0) for r in records),
        "answer_permission_count": 0,
        "source_truth_mutation_allowed_count": 0,
        "postgres_write_attempt_count": 0,
        "qdrant_read_attempt_count": 0,
        "qdrant_write_attempt_count": 0,
        "opensearch_write_attempt_count": 0,
        "opensearch_upload_attempt_count": 0,
        "write_attempt_count": 0,
        "unsafe_finding_count": sum(1 for r in records if r.get("unsafe")),
    }
    failures = []
    if summary["good_answer_count"] < min_good_answers:
        failures.append("good_answer_count_below_min")
    if summary["contract_pass_count"] < min_contract_pass:
        failures.append("contract_pass_count_below_min")
    if summary["fallback_used_count"] > max_fallback_used:
        failures.append("fallback_used_count_above_max")
    if summary["bad_answer_count"] > 0:
        failures.append("bad_answer_count_nonzero")
    if summary["unsupported_claim_count"] > 0:
        failures.append("unsupported_claim_count_nonzero")
    summary["quality_failures"] = failures
    quality_status = "PASS" if not failures else "FAIL"

    manifest = {
        "status": "TRACE_NET_H38_DIVERSITY_TASK_RUN_BUILT",
        "quality_status": quality_status,
        "summary": summary,
        "runner_policy": {
            "mode": "diversity_planner_consuming_custom_task_runner",
            "proof_boundary": "Selected diversity cards are proof_context candidates; final factual claims require cited cards. Planner/Engram guidance is not proof.",
            "forbidden": [
                "answer_permission_from_runner",
                "source_truth_mutation_from_runner",
                "summary_or_engram_used_as_proof",
                "live_io_from_runner",
            ],
        },
        "source_paths": {"diversity_planner": str(diversity_planner)},
        "records": records,
    }
    _write_json(out / f"{MODULE}.json", manifest)
    _write_json(out / f"{MODULE}_quality_check.json", {
        "status": "TRACE_NET_H38_DIVERSITY_TASK_RUN_CHECKED",
        "quality_status": quality_status,
        "summary": summary,
    })
    return manifest


def check_diversity_task_run(
    diversity_task_run: str | Path,
    min_records: int = 5,
    min_good_answers: int = 5,
    min_contract_pass: int = 5,
    max_fallback_used: int = 0,
    require_quality_pass: bool = False,
    require_no_answer_permission: bool = False,
    max_unsafe: int = 0,
    max_write_attempts: int = 0,
) -> Dict[str, Any]:
    data = _read_json(diversity_task_run)
    s = data.get("summary", {})
    failures = []
    if int(s.get("question_count") or 0) < min_records:
        failures.append("question_count_below_min")
    if int(s.get("good_answer_count") or 0) < min_good_answers:
        failures.append("good_answer_count_below_min")
    if int(s.get("contract_pass_count") or 0) < min_contract_pass:
        failures.append("contract_pass_count_below_min")
    if int(s.get("fallback_used_count") or 0) > max_fallback_used:
        failures.append("fallback_used_count_above_max")
    if require_quality_pass and data.get("quality_status") != "PASS":
        failures.append("quality_not_pass")
    if require_no_answer_permission and int(s.get("answer_permission_count") or 0) != 0:
        failures.append("answer_permission_nonzero")
    if int(s.get("unsafe_finding_count") or 0) > max_unsafe:
        failures.append("unsafe_finding_count_above_max")
    if int(s.get("write_attempt_count") or 0) > max_write_attempts:
        failures.append("write_attempt_count_above_max")
    return {
        "status": "TRACE_NET_H38_DIVERSITY_TASK_RUN_CHECKED",
        "quality_status": "PASS" if not failures else "FAIL",
        "question_count": int(s.get("question_count") or 0),
        "good_answer_count": int(s.get("good_answer_count") or 0),
        "contract_pass_count": int(s.get("contract_pass_count") or 0),
        "fallback_used_count": int(s.get("fallback_used_count") or 0),
        "bad_answer_count": int(s.get("bad_answer_count") or 0),
        "unsupported_claim_count": int(s.get("unsupported_claim_count") or 0),
        "unsafe_finding_count": int(s.get("unsafe_finding_count") or 0),
        "answer_permission_count": int(s.get("answer_permission_count") or 0),
        "write_attempt_count": int(s.get("write_attempt_count") or 0),
        "quality_failures": failures,
    }


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run TRACE-Net H38 diversity-planner custom tasks")
    parser.add_argument("--diversity-planner", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--llm-mode", default="ollama", choices=["ollama", "artifact"])
    parser.add_argument("--ollama-model", default="gemma4:26b")
    parser.add_argument("--ollama-url", default="http://127.0.0.1:11434/api/generate")
    parser.add_argument("--timeout-seconds", type=int, default=420)
    parser.add_argument("--max-questions", type=int, default=5)
    parser.add_argument("--answer-hard-max-chars", type=int, default=1500)
    parser.add_argument("--min-good-answers", type=int, default=5)
    parser.add_argument("--min-contract-pass", type=int, default=5)
    parser.add_argument("--max-fallback-used", type=int, default=0)
    parser.add_argument("--no-progress", action="store_true")
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)
    kwargs = vars(args).copy()
    no_progress = bool(kwargs.pop("no_progress", False))
    manifest = run_diversity_task_runner(progress=not no_progress, **kwargs)
    s = manifest["summary"]
    print("status=TRACE_NET_H38_DIVERSITY_TASK_RUN_BUILT")
    print(f"quality_status={manifest['quality_status']}")
    print(f"question_count={s['question_count']}")
    print(f"good_answer_count={s['good_answer_count']}")
    print(f"partial_answer_count={s['partial_answer_count']}")
    print(f"bad_answer_count={s['bad_answer_count']}")
    print(f"contract_pass_count={s['contract_pass_count']}")
    print(f"fallback_used_count={s['fallback_used_count']}")
    print(f"unsupported_claim_count={s['unsupported_claim_count']}")
    print(f"output={Path(args.output_dir) / (MODULE + '.json')}")
    return 0 if manifest["quality_status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
