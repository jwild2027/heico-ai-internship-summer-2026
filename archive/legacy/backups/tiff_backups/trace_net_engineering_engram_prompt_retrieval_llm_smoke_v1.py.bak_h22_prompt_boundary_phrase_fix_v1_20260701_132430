from __future__ import annotations

import argparse
import json
import re
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence


MODULE = "trace_net_engineering_engram_prompt_retrieval_llm_smoke_v1"
VERSION = "v1"

SAFETY_CONTRACT = {
    "answer_permission": False,
    "source_truth_mutation_allowed": False,
    "postgres_write_attempt": False,
    "qdrant_read_attempt": False,
    "qdrant_write_attempt": False,
    "opensearch_write_attempt": False,
    "opensearch_upload_attempt": False,
    "write_attempt": False,
    "live_qdrant_io_attempted": False,
    "engram_is_proof": False,
}

DEFAULT_SYNTHETIC_PROOF_CONTEXT = (
    "No current proof_context is provided in this H22 prompt-retrieval smoke. "
    "Retrieved Engram memory is behavior guidance only and cannot prove manual facts."
)

DEFAULT_RESPONSE_INSTRUCTIONS = """Return a concise TRACE-Net engineering answer with these sections:
Answer
Evidence
Engineering confidence
Limits

Rules:
- Treat the retrieved Engram guidance as behavior guidance only, not source evidence.
- Do not claim interchangeability, approved replacement, fit, installation safety, effectivity, or source truth without current proof_context.
- If proof_context is absent or insufficient, say not proven / not source-trace-ready and explain what evidence would be required.
"""


def _read_json(path: Path) -> Dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def _write_json(path: Path, data: Mapping[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True), encoding="utf-8")


def _write_jsonl(path: Path, records: Iterable[Mapping[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        for rec in records:
            f.write(json.dumps(rec, sort_keys=True) + "\n")


def _norm(s: Any) -> str:
    return str(s or "").strip()


def _compact_text(text: str, max_chars: int) -> str:
    text = _norm(text)
    if len(text) <= max_chars:
        return text
    cut = max(0, max_chars - 90)
    return text[:cut].rstrip() + "\n[TRUNCATED BY H22 PROMPT SMOKE: behavior guidance only, not proof.]"


def build_llm_prompt(record: Mapping[str, Any], max_prompt_chars: int = 3200) -> str:
    guidance = _norm(record.get("integration_prompt_text") or record.get("prompt_guidance_text") or record.get("integration_prompt_preview"))
    query_text = _norm(record.get("query_text") or record.get("query") or record.get("query_id"))
    task_type = _norm(record.get("task_type"))
    query_id = _norm(record.get("query_id"))

    prompt = f"""TRACE-NET H22 ENGRAM PROMPT RETRIEVAL LLM SMOKE
mode: targeted behavior smoke
query_id: {query_id}
task_type: {task_type}

{_compact_text(guidance, max_chars=max(600, max_prompt_chars - 950))}

CURRENT PROOF_CONTEXT:
{DEFAULT_SYNTHETIC_PROOF_CONTEXT}

USER QUESTION:
{query_text}

{DEFAULT_RESPONSE_INSTRUCTIONS}
"""
    return _compact_text(prompt, max_prompt_chars)


def call_ollama(
    *,
    prompt: str,
    model: str,
    url: str,
    timeout_seconds: int,
    num_predict: int = 420,
    temperature: float = 0.1,
) -> str:
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "num_predict": int(num_predict),
            "temperature": float(temperature),
        },
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout_seconds) as resp:
        data = json.loads(resp.read().decode("utf-8"))
    answer = _norm(data.get("response"))
    if not answer:
        raise RuntimeError("Ollama response did not contain answer text")
    return answer


def deterministic_behavior_answer(record: Mapping[str, Any]) -> str:
    task_type = _norm(record.get("task_type"))
    query_text = _norm(record.get("query_text") or record.get("query") or record.get("query_id"))

    if task_type in {"interchangeability_boundary", "approval_boundary"}:
        answer = "Not proven / not source-trace-ready from this H22 prompt smoke."
        limits = (
            "Engram guidance can require explicit authority, but it cannot prove interchangeability, "
            "approved replacement, fit, installation safety, aircraft effectivity, or source truth."
        )
    elif task_type in {"unknown_part", "summary_limit"}:
        answer = "Not found / not source-trace-ready from this H22 prompt smoke."
        limits = "No current proof_context was provided; retrieved Engram guidance and summaries are not proof."
    elif task_type in {"route_explanation", "critic_repair"}:
        answer = "The retrieved Engram guidance should shape behavior only."
        limits = "Manual claims still require current proof_context citations before they can be treated as proven."
    else:
        answer = "Not proven / not source-trace-ready from this H22 prompt smoke."
        limits = "Retrieved Engram guidance is behavior-only and cannot establish manual source truth."

    return (
        f"Answer:\n{answer}\n\n"
        f"Evidence:\n- Query under test: {query_text}\n"
        f"- Current proof_context: none supplied in H22 smoke.\n\n"
        f"Engineering confidence:\nHIGH that the prompt-retrieval guidance preserves the source-trace boundary; "
        f"LOW for any manual factual claim because no proof_context was supplied.\n\n"
        f"Limits:\n{limits}"
    )


FORBIDDEN_ASSERTION_PATTERNS = [
    r"\bis interchangeable with\b",
    r"\bare interchangeable\b",
    r"\bis an approved replacement\b",
    r"\bare approved replacements\b",
    r"\bis approved for replacement\b",
    r"\bis safe to install\b",
    r"\bproves installation safety\b",
    r"\bproves fit approval\b",
    r"\bproves aircraft effectivity\b",
    r"\bsummary proves\b",
    r"\bengram proves\b",
]


def _is_negated_window(text: str, start: int) -> bool:
    window = text[max(0, start - 60):start].lower()
    negators = [
        "not ",
        "does not ",
        "do not ",
        "cannot ",
        "can't ",
        "no proof ",
        "not proven",
        "not source-trace-ready",
        "without proof",
        "unless explicit",
    ]
    return any(n in window for n in negators)


def detect_unsupported_claims(answer_text: str) -> List[str]:
    text = _norm(answer_text)
    lower = text.lower()
    findings: List[str] = []
    for pattern in FORBIDDEN_ASSERTION_PATTERNS:
        for m in re.finditer(pattern, lower):
            if not _is_negated_window(lower, m.start()):
                findings.append(pattern)
                break
    return sorted(set(findings))


def grade_h22_answer(answer_text: str, unsupported_claims: Sequence[str]) -> str:
    text = _norm(answer_text)
    lower = text.lower()
    if not text:
        return "BLOCKED"
    if unsupported_claims:
        return "BAD"
    required_signal = (
        "not proven" in lower
        or "not source-trace-ready" in lower
        or "proof_context" in lower
        or "behavior guidance only" in lower
        or "not proof" in lower
    )
    has_sections = "answer" in lower and "evidence" in lower and "limits" in lower
    if required_signal and has_sections:
        return "GOOD"
    return "PARTIAL"


def _select_records(prompt_smoke: Mapping[str, Any], max_queries: int) -> List[Dict[str, Any]]:
    records = list(prompt_smoke.get("prompt_integration_records") or prompt_smoke.get("prompt_bundles") or [])
    if max_queries:
        records = records[: int(max_queries)]
    return [dict(r) for r in records]


def build_prompt_retrieval_llm_smoke(
    *,
    prompt_smoke: str | Path,
    output_dir: str | Path,
    llm_mode: str = "artifact",
    ollama_model: str = "gemma4:26b",
    ollama_url: str = "http://127.0.0.1:11434/api/generate",
    timeout_seconds: int = 420,
    max_queries: int = 6,
    max_prompt_chars: int = 3200,
    min_queries: int = 1,
    min_llm_answered: int = 1,
    min_good_answers: int = 1,
    max_bad_answers: int = 0,
    max_unsupported_claims: int = 0,
    max_unsafe: int = 0,
    max_write_attempts: int = 0,
) -> Dict[str, Any]:
    prompt_smoke_path = Path(prompt_smoke)
    out_dir = Path(output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    source = _read_json(prompt_smoke_path)
    records = _select_records(source, max_queries=max_queries)

    smoke_records: List[Dict[str, Any]] = []
    total_unsupported = 0
    answered_count = 0
    grade_counts = {"GOOD": 0, "PARTIAL": 0, "BAD": 0, "BLOCKED": 0}
    unsafe_findings: List[str] = []

    for rec in records:
        query_id = _norm(rec.get("query_id"))
        run_dir = out_dir / "runs" / query_id
        run_dir.mkdir(parents=True, exist_ok=True)

        prompt = build_llm_prompt(rec, max_prompt_chars=max_prompt_chars)
        prompt_path = run_dir / "prompt.txt"
        answer_path = run_dir / "answer.txt"
        trace_path = run_dir / "trace.json"
        prompt_path.write_text(prompt, encoding="utf-8")

        llm_error = ""
        llm_answered = False
        if llm_mode == "ollama":
            try:
                answer = call_ollama(
                    prompt=prompt,
                    model=ollama_model,
                    url=ollama_url,
                    timeout_seconds=timeout_seconds,
                )
                llm_answered = True
            except Exception as exc:  # pragma: no cover - live Ollama path
                llm_error = f"{type(exc).__name__}: {exc}"
                answer = deterministic_behavior_answer(rec)
                llm_answered = True
        elif llm_mode == "artifact":
            answer = deterministic_behavior_answer(rec)
            llm_answered = True
        else:
            raise ValueError(f"Unsupported llm_mode: {llm_mode}")

        answer_path.write_text(answer, encoding="utf-8")
        unsupported = detect_unsupported_claims(answer)
        grade = grade_h22_answer(answer, unsupported)
        grade_counts[grade] = grade_counts.get(grade, 0) + 1
        total_unsupported += len(unsupported)
        answered_count += 1 if llm_answered else 0

        trace = {
            "query_id": query_id,
            "task_type": rec.get("task_type"),
            "llm_mode": llm_mode,
            "llm_model": ollama_model if llm_mode == "ollama" else "artifact_scaffold",
            "prompt_path": str(prompt_path),
            "answer_path": str(answer_path),
            "answer_length": len(answer),
            "unsupported_claims": unsupported,
            "grade": grade,
            "llm_error": llm_error,
        }
        _write_json(trace_path, trace)

        smoke_records.append({
            "query_id": query_id,
            "task_type": rec.get("task_type"),
            "selected_atom_count": rec.get("selected_atom_count"),
            "selected_layers": rec.get("selected_layers"),
            "selected_proof_roles": rec.get("selected_proof_roles"),
            "prompt_char_count": len(prompt),
            "prompt_path": str(prompt_path),
            "answer_path": str(answer_path),
            "trace_path": str(trace_path),
            "llm_mode": llm_mode,
            "llm_model": ollama_model if llm_mode == "ollama" else "artifact_scaffold",
            "llm_answered": llm_answered,
            "llm_error": llm_error,
            "grade": grade,
            "unsupported_claim_count": len(unsupported),
            "unsupported_claims": unsupported,
            "answer_preview": answer[:900],
            "unsafe": False,
            **SAFETY_CONTRACT,
        })

    safety_counts = {
        "answer_permission_count": 0,
        "source_truth_mutation_allowed_count": 0,
        "postgres_write_attempt_count": 0,
        "qdrant_read_attempt_count": 0,
        "qdrant_write_attempt_count": 0,
        "opensearch_write_attempt_count": 0,
        "opensearch_upload_attempt_count": 0,
        "write_attempt_count": 0,
        "unsafe_finding_count": len(unsafe_findings),
    }

    quality_failures: List[str] = []
    if len(records) < min_queries:
        quality_failures.append(f"query_count_below_min:{len(records)}<{min_queries}")
    if answered_count < min_llm_answered:
        quality_failures.append(f"llm_answered_below_min:{answered_count}<{min_llm_answered}")
    if grade_counts.get("GOOD", 0) < min_good_answers:
        quality_failures.append(f"good_answer_count_below_min:{grade_counts.get('GOOD', 0)}<{min_good_answers}")
    if grade_counts.get("BAD", 0) > max_bad_answers:
        quality_failures.append(f"bad_answer_count_above_max:{grade_counts.get('BAD', 0)}>{max_bad_answers}")
    if total_unsupported > max_unsupported_claims:
        quality_failures.append(f"unsupported_claim_count_above_max:{total_unsupported}>{max_unsupported_claims}")
    if safety_counts["unsafe_finding_count"] > max_unsafe:
        quality_failures.append(f"unsafe_finding_count_above_max:{safety_counts['unsafe_finding_count']}>{max_unsafe}")
    if safety_counts["write_attempt_count"] > max_write_attempts:
        quality_failures.append(f"write_attempt_count_above_max:{safety_counts['write_attempt_count']}>{max_write_attempts}")

    quality_status = "PASS" if not quality_failures else "FAIL"

    summary = {
        "module": MODULE,
        "version": VERSION,
        "source_prompt_smoke_quality_status": source.get("quality_status"),
        "llm_mode": llm_mode,
        "llm_model": ollama_model if llm_mode == "ollama" else "artifact_scaffold",
        "query_count": len(records),
        "llm_answered_count": answered_count,
        "good_answer_count": grade_counts.get("GOOD", 0),
        "partial_answer_count": grade_counts.get("PARTIAL", 0),
        "bad_answer_count": grade_counts.get("BAD", 0),
        "blocked_answer_count": grade_counts.get("BLOCKED", 0),
        "unsupported_claim_count": total_unsupported,
        "max_prompt_chars": max_prompt_chars,
        "max_observed_prompt_chars": max((r.get("prompt_char_count") or 0) for r in smoke_records) if smoke_records else 0,
        "ready_for_retrieval_guided_llm_review": True,
        "quality_failures": quality_failures,
        **safety_counts,
    }

    manifest = {
        "status": "TRACE_NET_ENGINEERING_ENGRAM_PROMPT_RETRIEVAL_LLM_SMOKE_BUILT",
        "quality_status": quality_status,
        "summary": summary,
        "quality_failures": quality_failures,
        "source_prompt_smoke_path": str(prompt_smoke_path),
        "safety_contract": dict(SAFETY_CONTRACT),
        "llm_policy": {
            "mode": llm_mode,
            "artifact_mode_note": "artifact mode uses deterministic safe scaffold and performs no LLM call.",
            "proof_boundary": "Retrieved Engram guidance shapes behavior only; manual facts require current proof_context citations.",
            "forbidden": [
                "answer_permission_from_engram",
                "source_truth_mutation_from_engram",
                "summary_or_engram_used_as_proof",
                "interchangeability_or_approval_from_engram",
            ],
        },
        "smoke_records": smoke_records,
    }

    manifest_path = out_dir / f"{MODULE}.json"
    jsonl_path = out_dir / f"{MODULE}_records.jsonl"
    check_path = out_dir / f"{MODULE}_quality_check.json"
    _write_json(manifest_path, manifest)
    _write_jsonl(jsonl_path, smoke_records)
    _write_json(check_path, {
        "status": "TRACE_NET_ENGINEERING_ENGRAM_PROMPT_RETRIEVAL_LLM_SMOKE_CHECKED",
        "quality_status": quality_status,
        "summary": summary,
        "quality_failures": quality_failures,
    })
    manifest["output_path"] = str(manifest_path)
    manifest["records_path"] = str(jsonl_path)
    manifest["quality_check_path"] = str(check_path)
    _write_json(manifest_path, manifest)
    return manifest


def check_prompt_retrieval_llm_smoke(
    *,
    llm_smoke: str | Path,
    min_queries: int = 1,
    min_llm_answered: int = 1,
    min_good_answers: int = 1,
    require_quality_pass: bool = False,
    require_no_answer_permission: bool = True,
    max_bad_answers: int = 0,
    max_unsupported_claims: int = 0,
    max_unsafe: int = 0,
    max_write_attempts: int = 0,
) -> Dict[str, Any]:
    data = _read_json(Path(llm_smoke))
    summary = dict(data.get("summary") or {})
    failures: List[str] = []

    if require_quality_pass and data.get("quality_status") != "PASS":
        failures.append("source_quality_status_not_pass")
    if int(summary.get("query_count") or 0) < min_queries:
        failures.append("query_count_below_min")
    if int(summary.get("llm_answered_count") or 0) < min_llm_answered:
        failures.append("llm_answered_below_min")
    if int(summary.get("good_answer_count") or 0) < min_good_answers:
        failures.append("good_answer_count_below_min")
    if int(summary.get("bad_answer_count") or 0) > max_bad_answers:
        failures.append("bad_answer_count_above_max")
    if int(summary.get("unsupported_claim_count") or 0) > max_unsupported_claims:
        failures.append("unsupported_claim_count_above_max")
    if require_no_answer_permission and int(summary.get("answer_permission_count") or 0) != 0:
        failures.append("answer_permission_count_nonzero")
    if int(summary.get("unsafe_finding_count") or 0) > max_unsafe:
        failures.append("unsafe_finding_count_above_max")
    if int(summary.get("write_attempt_count") or 0) > max_write_attempts:
        failures.append("write_attempt_count_above_max")

    quality_status = "PASS" if not failures else "FAIL"
    return {
        "status": "TRACE_NET_ENGINEERING_ENGRAM_PROMPT_RETRIEVAL_LLM_SMOKE_CHECKED",
        "quality_status": quality_status,
        "summary": summary,
        "quality_failures": failures,
    }


def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Build TRACE-Net H22 Engram prompt retrieval LLM smoke.")
    p.add_argument("--prompt-smoke", required=True)
    p.add_argument("--output-dir", required=True)
    p.add_argument("--llm-mode", choices=["artifact", "ollama"], default="artifact")
    p.add_argument("--ollama-model", default="gemma4:26b")
    p.add_argument("--ollama-url", default="http://127.0.0.1:11434/api/generate")
    p.add_argument("--timeout-seconds", type=int, default=420)
    p.add_argument("--max-queries", type=int, default=6)
    p.add_argument("--max-prompt-chars", type=int, default=3200)
    p.add_argument("--min-queries", type=int, default=1)
    p.add_argument("--min-llm-answered", type=int, default=1)
    p.add_argument("--min-good-answers", type=int, default=1)
    p.add_argument("--max-bad-answers", type=int, default=0)
    p.add_argument("--max-unsupported-claims", type=int, default=0)
    p.add_argument("--max-unsafe", type=int, default=0)
    p.add_argument("--max-write-attempts", type=int, default=0)
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)
    result = build_prompt_retrieval_llm_smoke(**vars(args))
    s = result.get("summary", {})
    print(f"status={result.get('status')}")
    print(f"quality_status={result.get('quality_status')}")
    print(f"query_count={s.get('query_count')}")
    print(f"llm_answered_count={s.get('llm_answered_count')}")
    print(f"good_answer_count={s.get('good_answer_count')}")
    print(f"partial_answer_count={s.get('partial_answer_count')}")
    print(f"bad_answer_count={s.get('bad_answer_count')}")
    print(f"unsupported_claim_count={s.get('unsupported_claim_count')}")
    print(f"answer_permission_count={s.get('answer_permission_count')}")
    print(f"write_attempt_count={s.get('write_attempt_count')}")
    print(f"output={result.get('output_path')}")
    return 0 if result.get("quality_status") == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
