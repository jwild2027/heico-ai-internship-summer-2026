def _load_json(path: Any) -> Dict[str, Any]:
    p = Path(path)
    return json.loads(p.read_text(encoding="utf-8"))


def _write_json(path: Any, data: Mapping[str, Any]) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")


def _write_text(path: Any, text: str) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text, encoding="utf-8")


def _slug(text: str, max_len: int = 16) -> str:
    s = re.sub(r"[^a-zA-Z0-9]+", "_", str(text or "").strip().lower()).strip("_")
    return (s or "q")[:max_len]


def _question_hash(text: str) -> str:
    return hashlib.sha1(str(text).encode("utf-8")).hexdigest()[:8]


def _hint_for_category(category: str, question: str) -> str:
    q = question.lower()
    c = category.lower()
    if "interchange" in q:
        return "inter"
    if "install" in q or "safety" in q:
        return "safe"
    if "replacement" in q:
        return "repl"
    if "not prove" in q or "limitations" in c:
        return "limit"
    if "compare" in q:
        return "compare"
    if "figure" in q:
        return "fig"
    if "part" in q or re.search(r"\d{3}-\d{5}-\d{3}", q):
        return "part"
    if "why" in q:
        return "why"
    return _slug(c or q, 8)


def _short_run_dir(root: Path, idx: int, category: str, question: str) -> Path:
    # Keep nested H13/H14 runner paths short on Windows. The downstream
    # engineering runner writes long quality-check filenames under
    # <run>/r/context_pack/, so the question/category text must not be part of
    # the directory name. The full question is preserved in JSON records.
    return root / f"q{idx:02d}_{_question_hash(question)[:6]}"


def _invoke_builder(fn: Callable[..., Any], kwargs: Mapping[str, Any]) -> Any:
    sig = inspect.signature(fn)
    filtered = {k: v for k, v in kwargs.items() if k in sig.parameters}
    return fn(**filtered)


def _load_questions(question_bank: Optional[Any], max_questions: int) -> List[Dict[str, str]]:
    if question_bank:
        records: List[Dict[str, str]] = []
        path = Path(question_bank)
        for i, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            line = line.strip()
            if not line:
                continue
            obj = json.loads(line)
            q = str(obj.get("question") or "").strip()
            if not q:
                raise ValueError(f"question_bank line {i} is missing question")
            records.append({
                "question_id": str(obj.get("question_id") or f"q{i:02d}"),
                "category": str(obj.get("category") or "custom"),
                "question": q,
            })
    else:
        records = list(DEFAULT_QUESTIONS)
    return records[: max(0, int(max_questions))] if max_questions else records


def _write_question_bank(path: Any, questions: Sequence[Mapping[str, Any]]) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("w", encoding="utf-8", newline="") as f:
        for q in questions:
            f.write(json.dumps(dict(q), ensure_ascii=False) + "\n")


