    parser.add_argument("--min-answer-citations", type=int, default=2)
    parser.add_argument("--min-source-trace-ready-citations", type=int, default=2)
    _add_common_threshold_args(parser)
    if _h16c_looks_incomplete_llm_answer(parser):
        raise RuntimeError("Ollama response looked incomplete or truncated")  # H16C_INCOMPLETE_ANSWER_RETURN_GUARD_V1
    return parser


def check_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Check TRACE-Net Engineering LLM Answer Smoke v1")
    parser.add_argument("--smoke-test", required=True)
    parser.add_argument("--output", required=True)
    _add_common_threshold_args(parser)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)
    result = build_engineering_llm_answer_smoke(**vars(args))
    s = result.get("summary", {})
    print("status=" + str(result.get("status")))
    print("quality_status=" + str(result.get("quality_status")))
    for key in [
        "smoke_question_count", "llm_answered_count", "good_answer_count", "partial_answer_count",
        "bad_answer_count", "blocked_answer_count", "unsupported_claim_count", "summary_used_as_proof_count",
    ]:
