#!/usr/bin/env python3
"""Experimental context graph for word embedding with Gemma.

This is a lightweight prototype, not a real vector-embedding pipeline.
Gemma is used here to suggest contextually related words for a seed term,
and those suggestions are assembled into a small graph that you can inspect.
"""

from __future__ import annotations

import argparse
import json
from collections import defaultdict
from typing import DefaultDict, Iterable

from ollama import ResponseError, chat


MODEL = "gemma3:4b"
SYSTEM_PROMPT = (
    "You help build a small context graph. "
    "Return only concise JSON with related words and short edge reasons."
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Build a tiny context graph from Gemma-generated related words."
    )
    parser.add_argument(
        "seed",
        nargs="?",
        default="embedding",
        help="The seed word to expand into a context graph.",
    )
    parser.add_argument(
        "--neighbors",
        type=int,
        default=8,
        help="How many related words to request from the model.",
    )
    parser.add_argument(
        "--focus",
        default="word usage in technical text",
        help="The context to bias the related words toward.",
    )
    return parser.parse_args()


def request_related_words(seed: str, focus: str, neighbors: int) -> dict[str, object]:
    prompt = (
        "Create a compact JSON object for a word-context graph. "
        f"Seed word: {seed}. "
        f"Context focus: {focus}. "
        f"Return exactly {neighbors} related words. "
        "Use this schema: {"
        '"seed": string, "focus": string, "related": ["
        "{\"word\": string, \"reason\": string}"'
        "]}. "
        "Keep reasons short and specific."
    )

    response = chat(
        MODEL,
        messages=[
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": prompt},
        ],
        stream=False,
    )

    content = response["message"]["content"]
    try:
        return json.loads(content)
    except json.JSONDecodeError:
        # If the model adds extra text around the JSON, keep the experiment usable by
        # falling back to a tiny wrapper that stores the raw output for inspection.
        return {
            "seed": seed,
            "focus": focus,
            "related": [],
            "raw_output": content,
        }


def build_graph(seed: str, related: Iterable[dict[str, str]]) -> DefaultDict[str, set[str]]:
    graph: DefaultDict[str, set[str]] = defaultdict(set)
    for item in related:
        word = item.get("word", "").strip()
        if not word:
            continue
        graph[seed].add(word)
        graph[word].add(seed)
    return graph


def print_graph(seed: str, payload: dict[str, object]) -> None:
    related = payload.get("related", [])
    graph = build_graph(seed, related if isinstance(related, list) else [])

    print(f"seed: {seed}")
    print(f"focus: {payload.get('focus', '')}")
    print()
    print("nodes:")
    for node in sorted(graph):
        print(f"  - {node}")
    print()
    print("edges:")
    for node in sorted(graph):
        for neighbor in sorted(graph[node]):
            if node < neighbor:
                print(f"  - {node} <-> {neighbor}")
    print()
    print("reasons:")
    for item in related if isinstance(related, list) else []:
        word = item.get("word", "").strip()
        reason = item.get("reason", "").strip()
        if word:
            print(f"  - {word}: {reason}")

    raw_output = payload.get("raw_output")
    if raw_output:
        print()
        print("raw model output:")
        print(raw_output)


def main() -> None:
    args = parse_args()
    try:
        payload = request_related_words(args.seed, args.focus, args.neighbors)
    except ResponseError as error:
        raise RuntimeError(
            f"Ollama could not run model '{MODEL}'. Make sure it is installed and available."
        ) from error

    print_graph(args.seed, payload)


if __name__ == "__main__":
    main()
