          "normalizer": "lowercase_keyword",
          "type": "keyword"
        },
        "score": {
          "type": "float"
        },
        "short_summary": {
          "analyzer": "technical_text",
          "type": "text"
        },
        "source_ocr_hash": {
          "normalizer": "lowercase_keyword",
          "type": "keyword"
        },
        "topics": {
          "type": "keyword"
        }
      }
    },
    "settings": {
      "analysis": {
        "analyzer": {
          "technical_text": {
            "filter": [
              "lowercase",
              "asciifolding"
            ],
            "tokenizer": "standard",
            "type": "custom"
          }
        },
        "normalizer": {
          "lowercase_keyword": {
            "filter": [
              "lowercase",
              "asciifolding"
            ],
            "type": "custom"
          }
        }
      },
      "number_of_replicas": 1,
      "number_of_shards": 3
    }
  },
