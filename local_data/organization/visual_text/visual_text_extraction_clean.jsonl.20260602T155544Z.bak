text assist:\n- Use it to decide where to look and to compare likely text.\n- Put OCR-only or context-only observations in \"OCR/context assist notes\".\n- If OCR says something but the image is not clear enough to confirm it, say that in \"OCR/context assist notes\" or \"Uncertain/unreadable\".\n\nExtraction rules:\n- Prefer exact visible words, labels, callouts, part numbers, item numbers, quantities, figure references, sheet references, and titles.\n- If a table/grid/list is visible but cells are blurry, describe the columns/structure and use \"unreadable\" for unclear cells.\n- Do not invent warnings, notes, part numbers, quantities, table cells, regulatory language, or procedures.\n- One short visual summary is allowed, but it must be based only on the visible/transcribed sections.\n\nNon-visible routing context, for awareness only:\n- page_id: t_p_120_", "prompt_version": "visual_text_v2_2", "provider": "ollama", "source": {"ocr_path": null, "source_url": "http://localhost:8080/rescarta/t_p_120_1176/000001", "tiff_path": "local_data\\rescarta_exports\\t_p_120_1176\\pages\\000001_00000001.tif"}, "status": "ok", "temperature": 0.0, "timeout_seconds": 600, "visual_text_cleanup_scores": {"clean_char_count": 1391, "cleanup_version": "visual_text_v2_3_cleanup", "original_char_count": 1512, "prompt_template_leakage_marker_count": 0, "prompt_template_leakage_markers": [], "prompt_template_leakage_risk": false, "requires_human_review": true, "section_bleed_marker_count": 4, "section_bleed_markers": ["OCR/context assist notes", "Page type", "Visible title/header", "Visual summary"], "section_bleed_risk": true, "supported_by_known_parts": [], "supported_by_ocr": [], "suspicious_phrase_markers": [], "suspicious_phrase_risk": false, "table_expected": false, "table_expected_but_not_extracted": false, "trust_reasons": ["section_bleed_risk"], "trust_tier": "C", "unsupported_part_number_count": 5, "unsupported_part_numbers": ["120/1176", "25-21-00", "OCR/CONTEXT", "OCR/CONTEXT